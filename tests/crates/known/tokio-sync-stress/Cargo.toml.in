# Generated by known.py from Cargo.toml.in: @TOKIO@ is a tokio checkout.
[package]
name = "ffs-tokio-sync-stress"
version = "0.1.0"
edition = "2021"
publish = false

[[bin]]
name = "tokio_sync_stress"
path = "src/main.rs"

[dependencies]
tokio = { path = "@TOKIO@/tokio", features = ["rt", "rt-multi-thread", "sync", "time", "macros"] }

[workspace]

[profile.release]
debug-assertions = true
overflow-checks = true
debug = 1
