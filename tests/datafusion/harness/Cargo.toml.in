# Generated by run.py from Cargo.toml.in: @DF@ is the DataFusion checkout.
[package]
name = "ffs-datafusion-harness"
version = "0.1.0"
edition = "2024"
publish = false

[[bin]]
name = "df_harness"
path = "src/main.rs"

[dependencies]
datafusion = { path = "@DF@/datafusion/core" }
arrow = { version = "59", default-features = false }
tokio = { version = "1", features = ["rt", "rt-multi-thread", "macros", "fs", "sync"] }
futures = "0.3"

[workspace]

[profile.release]
debug-assertions = true
overflow-checks = true
debug = 1
