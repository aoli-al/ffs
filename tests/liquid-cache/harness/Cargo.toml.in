# Generated by run.py from Cargo.toml.in: @LC@ is the liquid-cache checkout.
[package]
name = "ffs-liquid-cache-harness"
version = "0.1.0"
edition = "2024"
publish = false

[[bin]]
name = "lc_harness"
path = "src/main.rs"

[dependencies]
liquid-cache = { path = "@LC@/src/core" }
arrow = { version = "59.2.0", default-features = false }
tokio = { version = "1", features = ["rt", "rt-multi-thread", "fs"] }
tempfile = "3"
t4 = { version = "0.1.9", default-features = false }


[workspace]

# Optimized, but with the checks that catch bugs kept on.
[profile.release]
debug-assertions = true
overflow-checks = true
debug = 1
